[Unit]
Description=Hyper-V file copy service (FCopy) daemon
# Can't use BindsTo here as the device name and path are not stable
ConditionPathIsDirectory=/sys/bus/vmbus/devices/eb765408-105f-49b6-b4aa-c123b64d17d4/uio/

[Service]
ExecStart=/usr/sbin/hv_fcopy_uio_daemon -n
# Should be able to overwrite any user's files
CapabilityBoundingSet=CAP_DAC_OVERRIDE
# Needs to be able to read/write /dev/uioN
DeviceAllow=char-uio
NoNewPrivileges=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true

[Install]
WantedBy=multi-user.target
